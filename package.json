{
  "name": "npm-sbom-tool",
  "version": "0.1.0",
  "description": "An npm Software Bill of Materials (SBOM) generation tool and reusable engine",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "npm-sbom-tool": "src/cli.js"
  },
  "scripts": {
    "test": "node --test test/**/*.test.js",
    "test:scanner": "node --test test/scanner.test.js",
    "test:parser": "node --test test/parser.test.js",
    "test:resolver": "node --test test/dependencyResolver.test.js",
    "test:graph": "node --test test/dependencyGraph.test.js",
    "test:workspace": "node --test test/workspaceDiscovery.test.js",
    "test:cyclonedx": "node --test test/cyclonedxGenerator.test.js",
    "test:validator": "node --test test/validator.test.js",
    "test:integration": "node --test test/integration.test.js",
    "test:osv": "node --test test/osvClient.test.js",
    "test:matcher": "node --test test/vulnerabilityMatcher.test.js",
    "test:findings": "node --test test/vulnerabilityFindings.test.js",
    "test:vuln": "node --test test/vulnerabilityIntegration.test.js",
    "test:anomaly": "node --test test/anomalyDetector.test.js",
    "test:compare": "node --test test/dependencyComparison.test.js",
    "scan": "node src/cli.js scan",
    "check": "node --check src/index.js src/engine/index.js src/scanner/index.js src/cli.js src/errors.js src/fileDiscovery.js src/parser.js src/dependencyResolver.js src/dependencyGraph.js src/workspaceDiscovery.js src/cyclonedxGenerator.js src/validator.js src/osvClient.js src/vulnerabilityMatcher.js src/vulnerabilityFindings.js src/vulnerabilityChecker.js src/anomalyDetector.js src/dependencyComparison.js"
  },
  "keywords": [
    "sbom",
    "npm",
    "security",
    "dependency-analysis",
    "cyclonedx",
    "software-bill-of-materials"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1"
  }
}
